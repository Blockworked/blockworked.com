---
import Base from '../../layouts/Base.astro';
import Downloader from '../../components/Downloader.astro';
import { REPO_URL } from '../../lib/releases';
import { languagePaths, locale } from '../../lib/i18n';

export const getStaticPaths = languagePaths;
const { t, th } = locale(Astro.url);
const link = (url: string, text: string) => `<a href="${url}">${text}</a>`;
---

<Base title={t('Download')} description={t('Download Blockwork for Windows, macOS, or Linux.')}>
  <section class="page">
    <div class="container page-column">
      <h1>{t('Get Blockwork')}</h1>
      <p class="lede" set:html={th('Free and open source under the GPL-3.0. Every build below comes straight from the latest {release}.', { release: link(`${REPO_URL}/releases/latest`, th('GitHub release')) })} />
      <div class="dl-wrap">
        <Downloader mode="full" />
      </div>
      <p class="build-note" set:html={th('Prefer to build it yourself? Clone the {repository} and run {command}.', { repository: link(REPO_URL, th('repository')), command: '<code>just</code>' })} />
    </div>
  </section>
</Base>

<style>
  /* The same column and heading as the community and translation pages. */
  .page { padding: 64px 0 96px; }
  .page-column { max-width: 920px; }
  h1 {
    font-size: clamp(32px, 5vw, 44px);
    line-height: 1.15;
    font-weight: 700;
    text-wrap: balance;
  }
  .lede {
    margin-top: 10px;
    max-width: 60ch;
    font-size: 17px;
    line-height: 1.6;
    color: color-mix(in srgb, var(--blockstitch-text) 78%, var(--blockstitch-text-dim));
    text-wrap: pretty;
  }
  .lede :global(a), .build-note :global(a) { color: var(--blockstitch-accent); text-decoration: none; }
  .lede :global(a:hover), .build-note :global(a:hover) { text-decoration: underline; }
  .dl-wrap { margin-top: 28px; }
  .build-note {
    margin-top: 40px;
    font-size: 14px;
    color: var(--blockstitch-text-dim);
  }
  @media (max-width: 560px) {
    .page { padding: 40px 0 72px; }
  }
</style>
