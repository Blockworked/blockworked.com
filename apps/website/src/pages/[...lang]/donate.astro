---
import { ArrowUpRight } from '@lucide/astro';
import Base from '../../layouts/Base.astro';
import { REPO_URL } from '../../lib/releases';
import { COMMUNITY_URL, GITHUB_SPONSORS_URL, KOFI_URL, TRANSLATE_URL } from '../../lib/site';
import { languagePaths, locale } from '../../lib/i18n';
import data from '../../data/supporters.json';

export const getStaticPaths = languagePaths;
const { t, th, href } = locale(Astro.url);
const link = (url: string, text: string) => `<a href="${url}">${text}</a>`;

// The supporter wall: hand-kept in src/data/supporters.json for now.
type Tier = 'patron' | 'sponsor' | 'backer' | 'supporter';
interface Supporter { name: string; tier: Tier; until: string; url?: string; logo?: { light: string; dark?: string } }
const today = new Date().toISOString().slice(0, 10);
const all = (data.supporters as Supporter[]).filter(s => s.name);
const current = all.filter(s => s.until >= today);
const past = all.filter(s => s.until < today);
const tiers: { id: Tier; name: string; note: string }[] = [
  { id: 'patron', name: t('Patrons'), note: t('$500 or more in a year') },
  { id: 'sponsor', name: t('Sponsors'), note: t('$100 or more in a year') },
  { id: 'backer', name: t('Backers'), note: t('$25 or more in a year') },
  { id: 'supporter', name: t('Supporters'), note: t('Any amount') },
];
const linked = (s: Supporter) => (s.tier !== 'supporter' ? s.url : undefined);

const ways = [
  { url: KOFI_URL, title: 'Ko-fi', hint: t('One-off or monthly, by card or PayPal. No account needed.') },
  { url: GITHUB_SPONSORS_URL, title: 'GitHub Sponsors', hint: t('Monthly or one-time, with your GitHub account.') },
];
const help = [
  { url: REPO_URL, title: t('Star Blockwork on GitHub'), hint: t('It helps other people find it.') },
  { url: `${TRANSLATE_URL}/`, title: t('Translate'), hint: t('Bring Blockwork and these sites to your language.') },
  { url: COMMUNITY_URL, title: t('Share your blocks'), hint: t('Publish a pack on the community library.') },
  { url: `${REPO_URL}/issues`, title: t('Report a bug'), hint: t('Or suggest something that would make Blockwork better.') },
];
---

<Base title={t('Donate')} description={t('Blockwork is free and open source. Donations help keep it that way.')}>
  <section class="page">
    <div class="container page-column">
      <h1>{t('Donate')}</h1>
      <p class="lede">{t('Blockwork is free and open source, made by one person, Ethan Stokes. Donations pay for the domain, servers and code signing, and give more time to work on it.')}</p>

      <ul class="rows ways">
        {ways.map(w => (
          <li>
            <a class="row" href={w.url} rel="noopener">
              <span class="row-main">
                <span class="row-title">{w.title}</span>
                <span class="row-hint">{w.hint}</span>
              </span>
              <ArrowUpRight class="row-icon" />
            </a>
          </li>
        ))}
      </ul>

      {current.length > 0 && (
        <section class="wall" aria-labelledby="wall-heading">
          <h2 id="wall-heading">{t('Thank you')}</h2>
          <p class="section-note">{t('People who give and want to be listed. Being listed buys no say in what gets built.')}</p>
          {tiers.map(tier => {
            const people = current.filter(s => s.tier === tier.id);
            return people.length > 0 && (
              <div class:list={['tier', `tier-${tier.id}`]}>
                <h3>{tier.name} <span class="tier-note">{tier.note}</span></h3>
                <ul class="names">
                  {people.map(s => {
                    const url = linked(s);
                    // The site's theme toggle sets data-theme, so both logos are
                    // in the page and CSS shows the one that fits.
                    const inner = tier.id === 'patron' && s.logo ? (
                      s.logo.dark ? (
                        <>
                          <img class="logo-light" src={s.logo.light} alt={s.name} height="40" loading="lazy" />
                          <img class="logo-dark" src={s.logo.dark} alt={s.name} height="40" loading="lazy" />
                        </>
                      ) : <img src={s.logo.light} alt={s.name} height="40" loading="lazy" />
                    ) : s.name;
                    return <li>{url ? <a href={url} rel="sponsored noopener">{inner}</a> : <span>{inner}</span>}</li>;
                  })}
                </ul>
              </div>
            );
          })}
          {past.length > 0 && (
            <p class="past"><span>{t('Past supporters')}</span> {past.map(s => s.name).join(', ')}</p>
          )}
        </section>
      )}

      <section class="help" aria-labelledby="help-heading">
        <h2 id="help-heading">{t('Other ways to help')}</h2>
        <ul class="rows">
          {help.map(h => (
            <li>
              <a class="row" href={h.url}>
                <span class="row-main">
                  <span class="row-title">{h.title}</span>
                  <span class="row-hint">{h.hint}</span>
                </span>
                <ArrowUpRight class="row-icon" />
              </a>
            </li>
          ))}
        </ul>
      </section>

      <p class="fine" set:html={th('Donations go to Ethan Stokes personally. They are not tax-deductible, and they buy no features, support or say in the roadmap. If you want to be listed above, say so in your donation message. See the {terms}.', { terms: link(href('/terms'), th('terms')) })} />
    </div>
  </section>
</Base>

<style>
  /* The same column, heading and hairline rows as the download page. */
  .page { padding: 64px 0 96px; }
  .page-column { max-width: 920px; }
  h1 {
    font-size: clamp(32px, 5vw, 44px);
    line-height: 1.15;
    font-weight: 700;
    text-wrap: balance;
  }
  .lede {
    margin-top: 10px;
    max-width: 60ch;
    font-size: 17px;
    line-height: 1.6;
    color: color-mix(in srgb, var(--blockstitch-text) 78%, var(--blockstitch-text-dim));
    text-wrap: pretty;
  }
  h2 { margin: 0 0 8px; font-size: 20px; font-weight: 700; line-height: 1.2; }
  .rows { list-style: none; border-top: 1px solid var(--blockstitch-glass-border); }
  .rows > li { border-bottom: 1px solid var(--blockstitch-glass-border); }
  .ways { margin-top: 32px; }
  .row {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 6px;
    color: var(--blockstitch-text);
    text-decoration: none;
    transition: background var(--blockstitch-dur-fast) var(--blockstitch-ease-standard);
  }
  .row:hover { background: var(--blockstitch-hover-overlay); }
  .row:focus-visible { outline: 2px solid var(--blockstitch-accent); outline-offset: -2px; border-radius: 4px; }
  .row-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .row-title { font-weight: 600; font-size: 15px; }
  .row-hint { font-size: 13px; color: var(--blockstitch-text-dim); }
  .row :global(.row-icon) { width: 18px; height: 18px; flex-shrink: 0; color: var(--blockstitch-text-dim); }
  .row:hover :global(.row-icon) { color: var(--blockstitch-accent); }
  .ways .row-title { font-size: 17px; }

  .wall, .help { margin-top: 56px; }
  .section-note { font-size: 14px; color: var(--blockstitch-text-dim); margin-bottom: 8px; }
  .tier { padding: 16px 0; border-bottom: 1px solid var(--blockstitch-glass-border); }
  .tier:first-of-type { border-top: 1px solid var(--blockstitch-glass-border); }
  h3 { font-size: 13px; font-weight: 600; color: var(--blockstitch-text-dim); margin-bottom: 10px; }
  .tier-note { font-weight: 400; margin-left: 6px; }
  .names { list-style: none; display: flex; flex-wrap: wrap; align-items: center; gap: 8px 24px; }
  .names a { color: var(--blockstitch-text); text-decoration: none; }
  .names a:hover { color: var(--blockstitch-accent); }
  .tier-patron .names { gap: 16px 40px; font-size: 22px; font-weight: 700; }
  .tier-patron img { height: 40px; width: auto; display: block; }
  .logo-light { display: none !important; }
  :global(:root[data-theme="light"]) .logo-light { display: block !important; }
  :global(:root[data-theme="light"]) .logo-dark { display: none !important; }
  .tier-sponsor .names { font-size: 18px; font-weight: 600; }
  .tier-backer .names { font-size: 15px; }
  .tier-supporter .names { font-size: 14px; color: var(--blockstitch-text-dim); gap: 4px 16px; }
  .past { margin-top: 16px; font-size: 13px; color: var(--blockstitch-text-dim); }
  .past span { font-weight: 600; margin-right: 6px; }

  .fine {
    margin-top: 40px;
    max-width: 70ch;
    font-size: 13px;
    line-height: 1.6;
    color: var(--blockstitch-text-dim);
  }
  .fine :global(a) { color: var(--blockstitch-accent); text-decoration: none; }
  .fine :global(a:hover) { text-decoration: underline; }
  @media (max-width: 560px) {
    .page { padding: 40px 0 72px; }
  }
</style>
