---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { LANGUAGES, locale } from '../lib/i18n';

interface Props {
  title?: string;
  description?: string;
}

const L = locale(Astro.url);
const { t } = L;
const {
  title,
  description = t('Build keyboard and mouse macros by snapping blocks together. Free for Windows, macOS, and Linux.'),
} = Astro.props;
const fullTitle = title ? `${title} · Blockwork` : t('Blockwork - Blocky automation');
const canonical = new URL(Astro.url.pathname, Astro.site);
const alternates = LANGUAGES.length > 1 ? LANGUAGES.map(l => ({ tag: l.tag, href: new URL(l.prefix + (l.prefix && L.path === '/' ? '/' : L.path), Astro.site).href })) : [];
// For the head script: each language's prefix, by code and by lower-case tag.
const prefixes = Object.fromEntries(LANGUAGES.flatMap(l => [[l.code.toLowerCase(), l.prefix], [l.tag.toLowerCase(), l.prefix]]));
// The page's scripts read their strings from here (src/lib/client-i18n.ts).
const clientStrings = JSON.stringify(L.client()).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={L.tag} dir={L.dir} data-theme="dark" data-lang-prefix={L.prefix}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map(a => <link rel="alternate" hreflang={a.tag} href={a.href} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={alternates[0].href} />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/logo.png', Astro.site)} />
    <meta name="theme-color" content="#1d1e20" />
    <!-- Resolve the theme before first paint (the key predates the Qt
         editor; kept so returning visitors keep their choice), falling back
         to the OS preference rather than the app's dark default. -->
    <script is:inline>
      (function () {
        var t = null;
        // The cookie is shared with community.blockworked.com.
        var m = document.cookie.match(/(?:^|; )bw-theme=(light|dark)/);
        if (m) t = m[1];
        else try { t = localStorage.getItem('blockstitch-theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') {
          t = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        document.documentElement.dataset.theme = t;
      })();
    </script>
    <!-- Show the page in the language picked on either Blockworked site (the
         bw-lang cookie), else, on an English page, the browser's best offered
         one. Only built once there is a language besides English. -->
    {LANGUAGES.length > 1 && (
      <script is:inline define:vars={{ prefixes }}>
        (function () {
          var here = document.documentElement.dataset.langPrefix || '';
          var m = document.cookie.match(/(?:^|; )bw-lang=([A-Za-z0-9_@-]{2,20})/);
          var want = null;
          var find = function (code) {
            code = code.toLowerCase().replace(/_/g, '-');
            if (code in prefixes) return prefixes[code];
            code = code.split('-')[0];
            return code in prefixes ? prefixes[code] : null;
          };
          if (m) want = find(m[1].replace(/_/g, '-')) || '';
          else if (!here) {
            var list = navigator.languages || [navigator.language || ''];
            for (var i = 0; i < list.length && want === null; i++) want = find(list[i] || '');
          }
          if (want === null || want === here) return;
          var rest = location.pathname.slice(here.length) || '/';
          location.replace(want + (want && rest === '/' ? '/' : rest) + location.search + location.hash);
        })();
      </script>
    )}
    <!-- Fade between blockworked.com and community.blockworked.com. They're
         separate origins, so CSS cross-document view transitions (which
         global.css turns on within each site) don't reach across: the page
         fades its content out before following a link to the other site and
         leaves a short-lived cookie, and the page on the other side fades in
         when it finds that cookie. The header is identical on both, so it
         stays put. The community site serves the same script as /site.js
         (its src/site-nav.ts); keep the two in step. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var domain = /(^|\.)blockworked\.com$/.test(location.hostname) ? '; domain=blockworked.com' : '';
        var arriving = /(?:^|; )bw-xsite=1/.test(document.cookie);
        if (arriving) document.cookie = 'bw-xsite=; path=/; max-age=0' + domain;
        if (!window.matchMedia || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (arriving) {
          root.classList.add('xsite-in');
          var reveal = function () {
            requestAnimationFrame(function () {
              requestAnimationFrame(function () { root.classList.remove('xsite-in'); });
            });
          };
          if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', reveal);
          else reveal();
        }
        function isSister(u) {
          var h = u.hostname;
          return u.origin !== location.origin &&
            (h === 'blockworked.com' || /\.blockworked\.com$/.test(h) || h === location.hostname);
        }
        document.addEventListener('click', function (e) {
          if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          var a = e.target.closest && e.target.closest('a[href]');
          if (!a || (a.target && a.target !== '_self') || a.hasAttribute('download')) return;
          var u = new URL(a.href, location.href);
          if (!isSister(u)) return;
          e.preventDefault();
          document.cookie = 'bw-xsite=1; path=/; max-age=10; samesite=lax' + domain;
          root.classList.add('xsite-out');
          setTimeout(function () { location.href = u.href; }, 180);
        });
        // Coming back with the Back button can restore the faded-out page.
        addEventListener('pageshow', function (e) {
          if (e.persisted) root.classList.remove('xsite-out', 'xsite-in');
        });
      })();
    </script>
  </head>
  <body>
    {clientStrings !== '{}' && <script is:inline type="application/json" id="bw-i18n" set:html={clientStrings} />}
    <SiteHeader />
    <main>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
