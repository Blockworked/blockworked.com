---
// community.blockworked.com keeps a copy of this in its src/site-nav.ts; change both together.
import { Moon, Sun, Download } from '@lucide/astro';
import GitHubMark from './GitHubMark.astro';
import { logoAt } from '../lib/logo';
import { REPO_URL } from '../lib/releases';
import { NAV_LINKS } from '../lib/site';
import { locale } from '../lib/i18n';

// Mirrored on community.blockworked.com (see src/lib/site.ts): keep the
// markup and styles here in step with that copy.
const brandLogo = await logoAt(28);
const { t, href, path: here } = locale(Astro.url);
const path = here.replace(/\/$/, '') || '/';
---

<header class="site-header">
  <div class="container site-header-inner">
    <!-- On the home page this stays hidden until the big title has scrolled
         out of view (see index.astro). -->
    <a class:list={['brand', { 'brand-home': path === '/' }]} href={href('/')} inert={path === '/' ? true : undefined}>
      <img {...brandLogo} alt="" />
      <span>Blockwork</span>
    </a>
    <nav class="site-nav" aria-label="Main">
      {NAV_LINKS.map(l => (
        <a href={href(l.href)} aria-current={path === l.href ? 'page' : undefined}>{t(l.label)}</a>
      ))}
    </nav>
    <div class="site-header-actions">
      <a class="btn btn-icon btn-ghost" href={REPO_URL} title={t('Blockwork on GitHub')} aria-label={t('Blockwork on GitHub')}>
        <GitHubMark width="16" height="16" />
      </a>
      <button class="btn btn-icon btn-ghost theme-toggle" type="button" title={t('Toggle light/dark theme')} aria-label={t('Toggle light/dark theme')}>
        <Sun class="icon-sun" />
        <Moon class="icon-moon" />
      </button>
      <a class="btn btn-primary header-cta" href={href('/download')}><Download />{t('Download')}</a>
    </div>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
  btn?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('blockstitch-theme', next);
    } catch {
      // storage disabled: the toggle still works for this page view
    }
    // Shared with community.blockworked.com, which reads the same cookie.
    const domain = /(^|\.)blockworked\.com$/.test(location.hostname) ? '; domain=blockworked.com' : '';
    document.cookie = `bw-theme=${next}; path=/; max-age=31536000; samesite=lax${domain}`;
  });
</script>

<style>
  /* blockstitch `.toolbar-row` */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--blockstitch-glass-bg);
    /* Kept in place (not cross-faded) by same-site view transitions. */
    view-transition-name: site-header;
    border-bottom: 1px solid var(--blockstitch-glass-border);
  }
  .site-header-inner {
    display: flex;
    align-items: center;
    gap: var(--blockstitch-spacing);
    height: 56px;
  }
  /* Same weight and tracking as the home page's big wordmark. */
  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 17px;
    line-height: 1;
    text-decoration: none;
  }
  .site-nav {
    display: flex;
    gap: 2px;
  }
  .brand + .site-nav { margin-left: 16px; }
  .brand-home { visibility: hidden; }
  .brand-home.brand-shown { visibility: visible; }
  .site-nav a {
    padding: 6px 10px;
    border-radius: var(--blockstitch-radius);
    font-size: 13px;
    color: var(--blockstitch-text-dim);
    text-decoration: none;
    transition: background var(--blockstitch-dur-fast) var(--blockstitch-ease-standard), color var(--blockstitch-dur-fast) var(--blockstitch-ease-standard);
  }
  .site-nav a:hover { background: var(--blockstitch-hover-overlay); color: var(--blockstitch-text); }
  .site-nav a[aria-current='page'] { color: var(--blockstitch-text); }
  .site-header-actions {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
  }
  .theme-toggle .icon-moon { display: none; }
  :global(:root[data-theme='light']) .theme-toggle .icon-sun { display: none; }
  :global(:root[data-theme='light']) .theme-toggle .icon-moon { display: block; }

  @media (max-width: 920px) {
    .site-nav { display: none; }
  }
  @media (max-width: 400px) {
    .header-cta { display: none; }
  }
</style>
