---
// Latest-release downloader, ported from ethanstokes.dev's Kobweb
// BlockworkPage: fetches the latest GitHub release in the browser (so the
// static site never goes stale between deploys), suggests the build for the
// visitor's OS/arch, and in `full` mode lists every asset by platform.
import { Check, Download, ExternalLink } from '@lucide/astro';
import { RELEASES_URL, PLATFORM_LABELS, type Platform } from '../lib/releases';
import { locale } from '../lib/i18n';

interface Props {
  mode?: 'compact' | 'full';
  align?: 'start' | 'center';
}
const { mode = 'full', align = 'start' } = Astro.props;
const { t, th, href } = locale(Astro.url);
const AUR_URL = 'https://aur.archlinux.org/packages/blockwork-bin';
const FLATPAK_REF = 'https://flatpak.blockworked.com/blockwork.flatpakref';
const COPR_URL = 'https://copr.fedorainfracloud.org/coprs/ethanstokes/Blockwork/';
const NIX_URL = 'https://github.com/Blockworked/Blockwork#linux';
const STORE_URL = 'https://apps.microsoft.com/detail/9PMN4BMXPH54';

const platforms: Platform[] = ['windows', 'macos', 'linux'];
---

<div class:list={['dl', { 'dl-center': align === 'center' }]} data-downloader data-mode={mode}>
  <div class="dl-primary">
    <div class="dl-buttons">
      <a class="btn btn-primary btn-lg" href={RELEASES_URL} data-recommended>
        <Download />
        <span data-recommended-label>{t('Download Blockwork')}</span>
      </a>
      <slot name="actions" />
    </div>
    <div class="dl-info">
      {mode === 'compact' && (
        <p class="dl-other">
          {t('Not on this platform?')} <a href={href('/download')}>{t('See all downloads')}</a> <a href={RELEASES_URL}>{t('Release history')}</a>
        </p>
      )}
    </div>
  </div>

  {mode === 'full' && (
    <p class="dl-release" data-release hidden>
      <span>{t('Latest release')}</span>
      <a class="dl-version" data-release-version href={href('/changelog')}></a>
      <time data-release-date></time>
      <a href={href('/changelog')}>{t("What's new")}</a>
    </p>
  )}

  {mode === 'full' && (
    <div class="dl-groups" data-groups hidden>
      {platforms.map(id => (
        <section class="dl-platform" data-platform={id}>
          <h2>{PLATFORM_LABELS[id]}</h2>
          <ul class="dl-list" data-rows>
            {id === 'windows' && (
              <li data-static>
                <a class="dl-row" href={STORE_URL}>
                  <span class="dl-row-main">
                    <span class="dl-row-title">Microsoft Store <span class="dl-arch">{t('x64 and ARM64')}</span></span>
                    <span class="dl-hint">{t('Installs and updates through the Store')}</span>
                  </span>
                  <ExternalLink class="dl-icon" />
                </a>
              </li>
            )}
            {id === 'linux' && (
              <li data-static>
                <a class="dl-row" href={FLATPAK_REF}>
                  <span class="dl-row-main">
                    <span class="dl-row-title">{t('Flatpak repository')} <span class="dl-arch">{t('Any distribution')}</span></span>
                    <span class="dl-hint" set:html={th('Open it to install, or run {command}. Updates with flatpak update', { command: '<code>flatpak install https://flatpak.blockworked.com/blockwork.flatpakref</code>' })} />
                  </span>
                  <Download class="dl-icon" />
                </a>
              </li>
            )}
            {id === 'linux' && (
              <li data-static>
                <a class="dl-row" href={COPR_URL}>
                  <span class="dl-row-main">
                    <span class="dl-row-title">COPR <span class="dl-arch">Fedora 43+</span></span>
                    <span class="dl-hint" set:html={th('Updates with the system: {command}', { command: '<code>sudo dnf copr enable ethanstokes/Blockwork</code>, <code>sudo dnf install blockwork</code>' })} />
                  </span>
                  <ExternalLink class="dl-icon" />
                </a>
              </li>
            )}
            {id === 'linux' && (
              <li data-static>
                <a class="dl-row" href={AUR_URL}>
                  <span class="dl-row-main">
                    <span class="dl-row-title">AUR <span class="dl-arch">Arch Linux</span></span>
                    <span class="dl-hint" set:html={th('Prebuilt: {prebuilt}, or from source: {source}', { prebuilt: '<code>paru -S blockwork-bin</code>', source: '<code>paru -S blockwork</code>' })} />
                  </span>
                  <ExternalLink class="dl-icon" />
                </a>
              </li>
            )}
            {id === 'linux' && (
              <li data-static>
                <a class="dl-row" href={NIX_URL}>
                  <span class="dl-row-main">
                    <span class="dl-row-title">Nix <span class="dl-arch">NixOS</span></span>
                    <span class="dl-hint" set:html={th('Run it with {command}, or enable programs.blockwork on NixOS', { command: '<code>nix run github:Blockworked/Blockwork</code>' })} />
                  </span>
                  <ExternalLink class="dl-icon" />
                </a>
              </li>
            )}
          </ul>
        </section>
      ))}
    </div>
  )}

  <template data-row-template>
    <li>
      <a class="dl-row" data-link>
        <span class="dl-row-main">
          <span class="dl-row-title">
            <span data-kind></span> <span class="dl-arch" data-arch></span>
            <span class="dl-suggested" data-suggested hidden><Check />{t('Suggested for this computer')}</span>
          </span>
          <span class="dl-hint" data-hint></span>
        </span>
        <span class="dl-size" data-size></span>
        <Download class="dl-icon" />
      </a>
    </li>
  </template>
</div>

<script>
  import {
    PLATFORM_LABELS, RELEASES_URL, REPO, formatDate, formatSize, parseAsset,
    type Arch, type GitHubRelease, type Platform, type ReleaseAsset,
  } from '../lib/releases';
  import { ct, localHref } from '../lib/client-i18n';

  interface NavigatorUAData {
    platform: string;
    getHighEntropyValues(hints: string[]): Promise<{ architecture?: string }>;
  }

  async function detect(): Promise<{ platform: Platform | null; arch: Arch }> {
    const uaData = (navigator as Navigator & { userAgentData?: NavigatorUAData }).userAgentData;
    const ua = navigator.userAgent.toLowerCase();
    const src = (uaData?.platform ?? '').toLowerCase() || ua;

    let platform: Platform | null = null;
    if (/android|iphone|ipad/.test(ua)) platform = null;
    else if (src.includes('win')) platform = 'windows';
    else if (src.includes('mac')) platform = 'macos';
    else if (src.includes('linux') || src.includes('x11') || src.includes('cros')) platform = 'linux';

    // Every Mac browser reports "Intel Mac OS X", so a Mac is taken to be
    // Apple silicon unless the architecture hint says otherwise.
    let arch: Arch = platform === 'macos' || /arm64|aarch64/.test(ua) ? 'arm64' : 'x86_64';
    try {
      const hints = await uaData?.getHighEntropyValues(['architecture']);
      if (hints?.architecture === 'arm') arch = 'arm64';
      else if (hints?.architecture === 'x86') arch = 'x86_64';
    } catch {
      // Hint unavailable: keep the UA-string guess.
    }
    return { platform, arch };
  }

  function pickRecommended(assets: ReleaseAsset[], platform: Platform | null, arch: Arch) {
    if (!platform) return null;
    const matches = assets.filter(a => a.platform === platform);
    return (
      matches.find(a => a.arch === arch && a.rank === 0) ??
      matches.find(a => a.arch === arch) ??
      matches.find(a => a.rank === 0) ??
      null
    );
  }

  // One request shared by every downloader on the page (the home page has two),
  // since unauthenticated GitHub API calls are limited to 60/hour per visitor.
  const latestRelease: Promise<GitHubRelease> = fetch(`https://api.github.com/repos/${REPO}/releases/latest`, {
    headers: { Accept: 'application/vnd.github+json' },
  }).then(res => {
    if (!res.ok) throw new Error(`GitHub API responded ${res.status}`);
    return res.json();
  });

  const archLabel = (a: ReleaseAsset) =>
    a.platform === 'macos' ? (a.arch === 'arm64' ? ct('Apple silicon') : ct('Intel')) : a.arch === 'arm64' ? 'ARM64' : 'x64';

  async function init(root: HTMLElement) {
    const recommendedLink = root.querySelector<HTMLAnchorElement>('[data-recommended]')!;
    const recommendedLabel = root.querySelector<HTMLElement>('[data-recommended-label]')!;

    let release: GitHubRelease;
    try {
      release = await latestRelease;
    } catch {
      recommendedLabel.textContent = ct('View releases on GitHub');
      recommendedLink.href = RELEASES_URL;
      return;
    }

    const assets = release.assets.map(parseAsset).filter((a): a is ReleaseAsset => a !== null);
    const { platform, arch } = await detect();
    const recommended = pickRecommended(assets, platform, arch);

    if (recommended) {
      recommendedLink.href = recommended.url;
      recommendedLabel.textContent = ct('Download for {platform}', { platform: PLATFORM_LABELS[recommended.platform] });
    } else {
      recommendedLink.href = root.dataset.mode === 'full' ? '#all-downloads' : localHref('/download');
      recommendedLabel.textContent = ct('Choose a download');
    }

    const releaseLine = root.querySelector<HTMLElement>('[data-release]');
    if (releaseLine) {
      const version = releaseLine.querySelector<HTMLAnchorElement>('[data-release-version]')!;
      version.textContent = release.tag_name;
      version.href += `#${release.tag_name}`;
      const date = releaseLine.querySelector<HTMLTimeElement>('[data-release-date]')!;
      date.dateTime = release.published_at.slice(0, 10);
      date.textContent = formatDate(release.published_at, document.documentElement.lang || 'en-US');
      releaseLine.hidden = false;
    }

    const groups = root.querySelector<HTMLElement>('[data-groups]');
    const template = root.querySelector<HTMLTemplateElement>('[data-row-template]');
    if (!groups || !template) return;
    groups.id = 'all-downloads';

    for (const section of groups.querySelectorAll<HTMLElement>('[data-platform]')) {
      const id = section.dataset.platform as Platform;
      const rows = section.querySelector<HTMLElement>('[data-rows]')!;
      // Builds for the visitor's architecture first; on someone else's platform,
      // its most common one (Apple silicon for Macs).
      const prefer: Arch = id === platform || id !== 'macos' ? arch : 'arm64';
      const list = assets
        .filter(a => a.platform === id)
        .sort((a, b) => Number(a.arch !== prefer) - Number(b.arch !== prefer) || a.rank - b.rank);
      if (list.length === 0) {
        section.hidden = true;
        continue;
      }
      // The visitor's own platform goes first.
      if (id === platform) groups.prepend(section);
      for (const asset of list) {
        const row = template.content.firstElementChild!.cloneNode(true) as HTMLElement;
        row.querySelector('[data-kind]')!.textContent = asset.kind;
        row.querySelector('[data-arch]')!.textContent = archLabel(asset);
        row.querySelector('[data-hint]')!.textContent = asset.hint;
        row.querySelector('[data-size]')!.textContent = formatSize(asset.size);
        const link = row.querySelector<HTMLAnchorElement>('[data-link]')!;
        link.href = asset.url;
        link.title = asset.name;
        if (asset === recommended) row.querySelector<HTMLElement>('[data-suggested]')!.hidden = false;
        rows.insertBefore(row, rows.querySelector('[data-static]'));
      }
    }
    groups.hidden = false;
  }

  document.querySelectorAll<HTMLElement>('[data-downloader]').forEach(init);
</script>

<style>
  .dl-primary {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
  .dl-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .dl-center .dl-primary { align-items: center; }
  .dl-center .dl-buttons { justify-content: center; }
  .dl-center .dl-info { text-align: center; }
  .dl-center .dl-other { justify-content: center; }
  .dl-other {
    margin-top: 6px;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    font-size: 13px;
    color: var(--blockstitch-text-dim);
  }
  .dl-other a { color: var(--blockstitch-accent); text-decoration: none; }
  .dl-other a:hover { text-decoration: underline; }

  .dl-release {
    margin-top: 14px;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 14px;
    row-gap: 4px;
    font-size: 14px;
    color: var(--blockstitch-text-dim);
  }
  .dl-release[hidden] { display: none; }
  .dl-release a { color: var(--blockstitch-accent); text-decoration: none; }
  .dl-release a:hover { text-decoration: underline; }
  /* The version sits in the same box a block's value does. */
  .dl-release .dl-version {
    padding: 2px 7px;
    border-radius: 5px;
    border: 1px solid var(--blockstitch-border);
    background: var(--blockstitch-bg2);
    color: var(--blockstitch-text);
    font-size: 13px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .dl-release .dl-version:hover { color: var(--blockstitch-accent); text-decoration: none; }

  .dl-groups {
    display: flex;
    flex-direction: column;
    gap: 40px;
    margin-top: 56px;
  }
  .dl-platform h2 {
    margin: 0 0 8px;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.2;
  }
  /* Hairline rows, like the translation and block lists on the community site. */
  .dl-list {
    list-style: none;
    border-top: 1px solid var(--blockstitch-glass-border);
  }
  .dl-list > :global(li) { border-bottom: 1px solid var(--blockstitch-glass-border); }
  .dl-list :global(.dl-row) {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 6px;
    color: var(--blockstitch-text);
    text-decoration: none;
    transition: background var(--blockstitch-dur-fast) var(--blockstitch-ease-standard);
  }
  .dl-list :global(.dl-row:hover) { background: var(--blockstitch-hover-overlay); }
  .dl-list :global(.dl-row:focus-visible) { outline: 2px solid var(--blockstitch-accent); outline-offset: -2px; border-radius: 4px; }
  .dl-list :global(.dl-row-main) { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .dl-list :global(.dl-row-title) { display: flex; flex-wrap: wrap; align-items: baseline; column-gap: 6px; font-weight: 600; font-size: 15px; }
  .dl-list :global(.dl-arch) { font-weight: 400; color: var(--blockstitch-text-dim); font-size: 14px; }
  .dl-list :global(.dl-hint) { font-size: 13px; color: var(--blockstitch-text-dim); }
  .dl-list :global(.dl-hint code) { overflow-wrap: anywhere; }
  .dl-list :global(.dl-size) {
    font-size: 13px;
    color: var(--blockstitch-text-dim);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .dl-list :global(.dl-icon) { width: 18px; height: 18px; flex-shrink: 0; color: var(--blockstitch-text-dim); }
  .dl-list :global(.dl-row:hover .dl-icon) { color: var(--blockstitch-accent); }
  /* The build for this computer: a tick and a few words, not a pill. */
  .dl-list :global(.dl-suggested) {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    align-self: center;
    margin-left: 6px;
    font-size: 13px;
    font-weight: 400;
    color: var(--blockstitch-text-dim);
  }
  .dl-list :global(.dl-suggested[hidden]) { display: none; }
  .dl-list :global(.dl-suggested svg) { width: 13px; height: 13px; color: #3ccf6e; }
  :root[data-theme="light"] .dl-list :global(.dl-suggested svg) { color: #18743b; }

  @media (max-width: 560px) {
    .dl-list :global(.dl-row) { align-items: flex-start; gap: 12px; padding: 12px 2px; }
    .dl-list :global(.dl-suggested) { flex-basis: 100%; margin: 2px 0 0; }
    .dl-list :global(.dl-icon) { margin-top: 2px; }
  }
</style>
