---
// community.blockworked.com keeps a copy of this in its src/site-nav.ts; change both together.
import { REPO_URL, RELEASES_URL } from '../lib/releases';
import { COMMUNITY_URL, SUPPORT_URL, TRANSLATE_URL } from '../lib/site';
import { LANGUAGES, locale } from '../lib/i18n';
const { t, href, code } = locale(Astro.url);
import { logoAt } from '../lib/logo';
const year = new Date().getFullYear();
const footerLogo = await logoAt(22);
---

<footer class="site-footer">
  <div class="container site-footer-inner">
    <div class="footer-brand">
      <img {...footerLogo} alt="" loading="lazy" />
      <span>Blockwork</span>
    </div>
    <nav class="footer-links" aria-label={t('Footer')}>
      <a href={href('/download')}>{t('Download')}</a>
      <a href={href('/changelog')}>{t('Changelog')}</a>
      <a href={COMMUNITY_URL}>{t('Community blocks')}</a>
      <a href={`${SUPPORT_URL}/`}>{t('Support')}</a>
      <a href={REPO_URL}>{t('Source')}</a>
      <a href={`${REPO_URL}/issues`}>{t('Report an issue')}</a>
      <a href={RELEASES_URL}>{t('All releases')}</a>
      <a href={`${TRANSLATE_URL}/`}>{t('Help translate')}</a>
      <a href={href('/privacy')}>{t('Privacy')}</a>
      <a href={href('/terms')}>{t('Terms')}</a>
    </nav>
    {LANGUAGES.length > 1 && (
      <label class="language-picker">
        <span class="sr">{t('Language')}</span>
        <select data-language-picker aria-label={t('Language')}>
          {LANGUAGES.map(l => <option value={l.code} data-prefix={l.prefix} lang={l.tag} selected={l.code === code}>{l.name}</option>)}
        </select>
      </label>
    )}
    <p class="dim copyright">© {year} Blockworked</p>
  </div>
</footer>

<script>
  // The choice is kept in the bw-lang cookie, which community.blockworked.com reads too.
  document.querySelector<HTMLSelectElement>('[data-language-picker]')?.addEventListener('change', e => {
    const select = e.currentTarget as HTMLSelectElement;
    const domain = /(^|\.)blockworked\.com$/.test(location.hostname) ? '; domain=blockworked.com' : '';
    document.cookie = `bw-lang=${select.value}; path=/; max-age=31536000; samesite=lax${domain}`;
    const prefix = select.selectedOptions[0]?.dataset.prefix ?? '';
    const here = document.documentElement.dataset.langPrefix ?? '';
    const rest = location.pathname.slice(here.length) || '/';
    location.href = prefix + (prefix && rest === '/' ? '/' : rest) + location.hash;
  });
</script>

<style>
  .site-footer {
    border-top: 1px solid var(--blockstitch-glass-border);
    background: var(--blockstitch-glass-bg);
    padding: 28px 0;
    font-size: 13px;
  }
  .site-footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
  }
  .footer-brand { display: flex; align-items: center; gap: 8px; font-weight: 600; }
  .dim { color: var(--blockstitch-text-dim); font-weight: 400; }
  .footer-links { display: flex; flex-wrap: wrap; gap: 4px 16px; }
  .footer-links a { color: var(--blockstitch-text-dim); text-decoration: none; }
  .footer-links a:hover { color: var(--blockstitch-text); }
  .copyright { margin-left: auto; }
  .language-picker select {
    font: inherit;
    font-size: 13px;
    min-height: 28px;
    padding: 0 6px;
    border-radius: var(--blockstitch-radius);
    border: 1px solid var(--blockstitch-glass-border);
    background: transparent;
    color: var(--blockstitch-text-dim);
  }
  .language-picker select:hover { color: var(--blockstitch-text); }
  .language-picker + .copyright { margin-left: 0; }
  .language-picker { margin-left: auto; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
