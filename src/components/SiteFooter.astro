---
// community.blockworked.com keeps a copy of this in its src/site-nav.ts; change both together.
import { REPO_URL, RELEASES_URL } from '../lib/releases';
import { COMMUNITY_URL, SUPPORT_URL } from '../lib/site';
import { logoAt } from '../lib/logo';
const year = new Date().getFullYear();
const footerLogo = await logoAt(22);
---

<footer class="site-footer">
  <div class="container site-footer-inner">
    <div class="footer-brand">
      <img {...footerLogo} alt="" loading="lazy" />
      <span>Blockwork</span>
    </div>
    <nav class="footer-links" aria-label="Footer">
      <a href="/download">Download</a>
      <a href="/changelog">Changelog</a>
      <a href={COMMUNITY_URL}>Community blocks</a>
      <a href={`${SUPPORT_URL}/`}>Support</a>
      <a href={REPO_URL}>Source</a>
      <a href={`${REPO_URL}/issues`}>Report an issue</a>
      <a href={RELEASES_URL}>All releases</a>
    </nav>
    <p class="dim copyright">© {year} Blockworked</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--blockstitch-glass-border);
    background: var(--blockstitch-glass-bg);
    padding: 28px 0;
    font-size: 13px;
  }
  .site-footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
  }
  .footer-brand { display: flex; align-items: center; gap: 8px; font-weight: 600; }
  .dim { color: var(--blockstitch-text-dim); font-weight: 400; }
  .footer-links { display: flex; flex-wrap: wrap; gap: 4px 16px; }
  .footer-links a { color: var(--blockstitch-text-dim); text-decoration: none; }
  .footer-links a:hover { color: var(--blockstitch-text); }
  .copyright { margin-left: auto; }
</style>
