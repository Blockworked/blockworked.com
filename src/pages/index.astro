---
import Base from '../layouts/Base.astro';
import Downloader from '../components/Downloader.astro';
import Screenshots from '../components/Screenshots.astro';
import GitHubMark from '../components/GitHubMark.astro';
import {
  ChevronDown, Hand, RotateCw,
} from '@lucide/astro';
import { REPO_URL } from '../lib/releases';
---

<Base>
  <section class="hero">
    <div class="container hero-copy">
      <h1 class="hero-brand">
        <span class="hero-lockup">
          <img src="/logo.png" alt="" width="512" height="512" />
          <span>Blockwork</span>
        </span>
      </h1>
      <p class="hero-tagline">Powerful, understandable & fun <span class="accent">automation</span></p>
      <div class="hero-actions">
        <Downloader mode="compact" align="center">
          <a slot="actions" class="btn btn-lg" href={REPO_URL}><GitHubMark width="16" height="16" />View source</a>
        </Downloader>
      </div>
    </div>
    <a class="scroll-cue" href="#try" aria-label="Scroll down"><ChevronDown /></a>
  </section>

  <section class="try" id="try">
    <div class="container">
      <div class="hero-editor">
        <div class="editor-window" data-editor-window>
          <div class="editor-titlebar">
            <span class="dot" aria-hidden="true"></span><span class="dot" aria-hidden="true"></span><span class="dot" aria-hidden="true"></span>
            <span class="editor-titlebar-name" aria-hidden="true">Blockwork</span>
            <button type="button" class="editor-done" data-editor-done>Done</button>
          </div>
          <div class="editor-body">
            <!-- Blockwork's real Qt editor, compiled to WebAssembly (qt-demo/),
                 is drawn into this element once the page scrolls near it.
                 On phones it's scaled down to a wide thumbnail of the real
                 desktop-width layout (see `.editor-scale-wrap` below) instead
                 of letting the sidebar's fixed min-width dominate a narrow
                 screen; activating the editor drops the scale back to 1:1
                 inside a fullscreen overlay instead. -->
            <div class="editor-scale-wrap" data-editor-scale-wrap>
              <div class="qt-host" data-qt-screen="editor"></div>
              <div class="editor-loading dot-grid" data-editor-loading>Loading the editor…</div>
              <div class="editor-loading editor-stopped dot-grid" data-editor-stopped hidden>
                The editor stopped.
                <button type="button" data-editor-reload>Reload to start over</button>
              </div>
            </div>
            <!-- The editor would swallow every scroll or swipe that lands on it,
                 so it stays locked until clicked (see the script below). -->
            <button type="button" class="editor-unlock" data-editor-unlock>
              <Hand /><span class="unlock-click">Click to try the editor</span><span class="unlock-tap">Tap to try the editor</span>
            </button>
            <!-- Sidebar and canvas both get more room in landscape; only
                 shown once active, on phones, while held upright. -->
            <div class="editor-rotate-hint" data-editor-rotate-hint>
              <RotateCw /><span>Rotate your device for more room</span>
              <button type="button" class="editor-rotate-dismiss" data-editor-rotate-dismiss aria-label="Dismiss">✕</button>
            </div>
          </div>
        </div>
        <!-- Dims the page behind the fullscreen phone editor (see
             `.editor-active` under `pointer: coarse` below), which now
             floats with a gap instead of touching the screen edges. -->
        <div class="editor-mobile-scrim" data-editor-scrim aria-hidden="true"></div>
        <p class="editor-caption">A live copy of Blockwork's editor. Edits stay in this tab and nothing runs.</p>
      </div>
    </div>
  </section>

  <section class="section" id="features">
    <div class="container">
      <h2 class="section-heading">Everything a macro needs, nothing to memorize</h2>
      <p class="section-lede">
        Every instruction is a block with its own inputs. Value and condition slots are shaped by type,
        so you can tell what goes where at a glance.
      </p>

      <div class="features">
        <article class="feature">
          <div class="feature-copy">
            <h3>Record it once, then edit the blocks</h3>
            <p>Press Record and do the task yourself. Every key and button press and release comes back as its own block, with the real pause between them, ready to trim, retime, or loop.</p>
          </div>
          <div class="feature-stage" aria-hidden="true">
            <div class="qt-host" data-qt-screen="record"></div>
          </div>
        </article>
        <article class="feature">
          <div class="feature-copy">
            <h3>Build by dragging, not typing</h3>
            <p>Pull blocks from the sidebar and snap them into a stack. Each slot has a shape, so a condition can't end up where a number goes.</p>
          </div>
          <div class="feature-stage" aria-hidden="true">
            <div class="qt-host" data-qt-screen="snap"></div>
          </div>
        </article>
        <article class="feature">
          <div class="feature-copy">
            <h3>Loops and variables you can see</h3>
            <p>Repeat, while and if wrap around the blocks they control. Variables and operators like pick random fill the slots, and clicking one shows its value right now.</p>
          </div>
          <div class="feature-stage" aria-hidden="true">
            <div class="qt-host" data-qt-screen="logic"></div>
          </div>
        </article>
        <article class="feature">
          <div class="feature-copy">
            <h3>Make your own blocks</h3>
            <p>Turn a sequence you keep rebuilding into one block with its own inputs and color, then drop it into any macro.</p>
          </div>
          <div class="feature-stage" aria-hidden="true">
            <div class="qt-host" data-qt-screen="custom-block"></div>
          </div>
        </article>
        <article class="feature">
          <div class="feature-copy">
            <h3>Runs when you're not looking</h3>
            <p>Start a macro from a global hotkey, on a schedule, when a window comes into focus, or when the battery is full.</p>
          </div>
          <div class="feature-stage" aria-hidden="true">
            <div class="qt-host" data-qt-screen="battery"></div>
          </div>
        </article>
      </div>

      <dl class="specs panel">
        <div class="panel-row"><dt>Cross-platform</dt><dd>Windows, macOS, and Linux</dd></div>
        <div class="panel-row"><dt>Privacy</dt><dd>No account. Macros stay local.</dd></div>
        <div class="panel-row"><dt>Source Code</dt><dd><a href={REPO_URL}>GPL-3.0 on GitHub</a></dd></div>
      </dl>
    </div>
  </section>

  <section class="section section-alt" id="screenshots">
    <div class="container">
      <h2 class="section-heading">A canvas for your automations</h2>
      <p class="section-lede">Pan, zoom, leave comments, and keep as many macros as you like, with light and dark themes.</p>
      <Screenshots />
    </div>
  </section>

  <section class="section" id="download">
    <div class="container">
      <div class="cta panel">
        <img src="/logo.png" alt="" width="88" height="88" class="cta-logo" />
        <div class="cta-copy">
          <h2 class="section-heading">Get Blockwork</h2>
          <p class="section-lede">Free and open source. Grab the latest release for your platform.</p>
          <div class="cta-actions"><Downloader mode="compact" /></div>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { setEditorScale, startQtDemo } from '../lib/qtDemo';

  // The Qt editor is ~8 MB compressed, so it only starts once the visitor
  // scrolls toward it or the feature illustrations, which come from the same
  // instance.
  const loading = document.querySelector<HTMLElement>('[data-editor-loading]');
  const qtSections = document.querySelectorAll<HTMLElement>('#try, .features');
  // A crash after loading takes the whole editor down; say so over it.
  const stoppedCard = document.querySelector<HTMLElement>('[data-editor-stopped]');
  document.querySelector('[data-editor-reload]')?.addEventListener('click', () => location.reload());
  const stopped = (reason: string) => {
    console.error(reason);
    if (stoppedCard) stoppedCard.hidden = false;
  };
  const start = () => {
    startQtDemo(stopped)
      .then(() => loading?.remove())
      .catch(error => {
        console.error(error);
        if (loading) loading.textContent = "The editor couldn't start in this browser.";
      });
  };
  if (qtSections.length && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(entries => {
      if (!entries.some(e => e.isIntersecting)) return;
      observer.disconnect();
      start();
    }, { rootMargin: '600px 0px' });
    qtSections.forEach(el => observer.observe(el));
  } else {
    start();
  }

  // Unlock the demo editor on click, lock it again with Done. On phones this
  // also toggles a fullscreen overlay (see .editor-active under `pointer:
  // coarse` in the styles below) — lock page scroll behind it while it's up.
  const editorWindow = document.querySelector<HTMLElement>('[data-editor-window]');
  const rotateHint = document.querySelector<HTMLElement>('[data-editor-rotate-hint]');
  const coarsePointer = window.matchMedia('(pointer: coarse)');
  document.querySelector('[data-editor-unlock]')?.addEventListener('click', () => {
    editorWindow?.classList.add('editor-active');
    updateEditorPreviewScale();
    if (coarsePointer.matches) {
      document.body.classList.add('editor-fullscreen-lock');
      // Fullscreen the whole document rather than the editor window, so
      // the fixed overlay below keeps its gap and scrim.
      document.documentElement.requestFullscreen?.().catch(() => {});
    }
    rotateHint?.classList.remove('dismissed');
  });
  document.querySelector('[data-editor-done]')?.addEventListener('click', () => {
    if (document.fullscreenElement) document.exitFullscreen?.().catch(() => {});
    editorWindow?.classList.remove('editor-active');
    updateEditorPreviewScale();
    document.body.classList.remove('editor-fullscreen-lock');
  });
  document.querySelector('[data-editor-rotate-dismiss]')?.addEventListener('click', (e) => {
    e.stopPropagation();
    rotateHint?.classList.add('dismissed');
  });
  // Exiting fullscreen through the browser/OS (back gesture, Esc, …) instead
  // of the Done button should still close the editor.
  document.addEventListener('fullscreenchange', () => {
    if (document.fullscreenElement) return;
    editorWindow?.classList.remove('editor-active');
    updateEditorPreviewScale();
    document.body.classList.remove('editor-fullscreen-lock');
  });

  // Before activation on phones, the editor is laid out at a fixed
  // desktop-ish width and scaled down to fit the frame's real width (Qt does
  // the scaling; the frame's height follows `--editor-preview-scale`), so
  // phones get a proportional wide preview instead of a squeezed one.
  const EDITOR_PREVIEW_NATURAL_WIDTH = 680;
  function updateEditorPreviewScale() {
    if (!editorWindow) return;
    const scale = Math.min(1, editorWindow.clientWidth / EDITOR_PREVIEW_NATURAL_WIDTH);
    editorWindow.style.setProperty('--editor-preview-scale', String(scale));
    const thumbnail = coarsePointer.matches && !editorWindow.classList.contains('editor-active');
    setEditorScale(thumbnail ? scale : 1);
  }
  updateEditorPreviewScale();
  window.addEventListener('resize', updateEditorPreviewScale);

  // The header's logo is hidden on the home page while the big title is on
  // screen, and appears once the title has scrolled out of view behind the
  // header (plus a little extra scroll); scrolling back up hides it again.
  /** Extra scroll past the point where the title is fully hidden, in px. */
  const SHOW_AFTER = 40;

  const title = document.querySelector<HTMLElement>('.hero-brand');
  const header = document.querySelector<HTMLElement>('.site-header');
  const brand = document.querySelector<HTMLElement>('.site-header .brand-home');

  if (title && header && brand) {
    let threshold = 0;

    const update = () => {
      const shown = window.scrollY > threshold;
      brand.classList.toggle('brand-shown', shown);
      brand.toggleAttribute('inert', !shown);
    };

    const measure = () => {
      const titleBottom = title.getBoundingClientRect().bottom + window.scrollY;
      threshold = titleBottom - header.getBoundingClientRect().bottom + SHOW_AFTER;
      update();
    };

    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', measure);
    document.fonts?.ready.then(measure);
    window.addEventListener('load', measure);
    measure();
  }
</script>

<style>
  /* The header is 56px tall (SiteHeader.astro); the hero fills the rest of the first screen. */
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: calc(100vh - 56px);
    min-height: calc(100svh - 56px);
    padding: 80px 0 112px;
  }
  .hero-copy {
    position: relative;
    max-width: 1000px;
    text-align: center;
  }
  /* The logo and name are the headline: the lockup leads, the tagline follows. */
  .hero-brand {
    font-size: clamp(56px, 11vw, 148px);
    line-height: 1;
    font-weight: 800;
    letter-spacing: -0.045em;
  }
  .hero-lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.22em;
  }
  .hero-brand img {
    width: 1.05em;
    height: 1.05em;
    flex-shrink: 0;
  }
  .hero-tagline {
    margin-top: clamp(20px, 2.4vw, 32px);
    font-size: clamp(24px, 3vw, 38px);
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--blockstitch-text);
  }
  .accent { color: var(--blockstitch-accent); }
  /* Spacing grows between groups: logo + tagline, then the description, then the actions. */
  .hero-lede {
    margin: clamp(36px, 4.5vw, 56px) auto 0;
    max-width: 58ch;
    font-size: clamp(17px, 1.7vw, 20px);
    line-height: 1.7;
    color: color-mix(in srgb, var(--blockstitch-text) 78%, var(--blockstitch-text-dim));
    text-wrap: balance;
  }
  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 28px;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-left: -20px;
    border-radius: 50%;
    color: var(--blockstitch-text-dim);
    transition: color var(--blockstitch-dur-fast) var(--blockstitch-ease-standard), background var(--blockstitch-dur-fast) var(--blockstitch-ease-standard);
  }
  .scroll-cue:hover { color: var(--blockstitch-text); background: var(--blockstitch-hover-overlay); }
  .scroll-cue :global(svg) { width: 22px; height: 22px; }
  @media (prefers-reduced-motion: no-preference) {
    .scroll-cue :global(svg) { animation: cue-bob 2.4s var(--blockstitch-ease-standard) infinite; }
  }
  @keyframes cue-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(4px); }
  }

  .hero-actions { margin-top: clamp(36px, 4.5vw, 56px); display: flex; justify-content: center; }
  .hero-actions :global(.dl-primary) { gap: 18px; }
  .hero-actions :global(.btn-lg) { min-height: 48px; padding: 0 22px; }
  .try { padding: 24px 0 40px; }
  .editor-window {
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--blockstitch-border);
    background: var(--blockstitch-bg);
    box-shadow: var(--blockstitch-shadow-lg), 0 0 0 1px var(--blockstitch-glass-border);
  }
  .editor-titlebar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 6px;
    height: 30px;
    padding: 0 12px;
    background: var(--blockstitch-bg2);
    border-bottom: 1px solid var(--blockstitch-glass-border);
  }
  .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--blockstitch-bg3); border: 1px solid var(--blockstitch-border); }
  .editor-titlebar-name {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    font-size: 12px;
    color: var(--blockstitch-text-dim);
  }
  /* blockstitch's editor expects to fill a fixed-size window. */
  .editor-body {
    position: relative;
    height: min(600px, 78vh);
    font-size: 14px;
    line-height: normal;
  }
  .editor-scale-wrap { position: absolute; inset: 0; }
  /* Qt sizes each screen to its host element and follows it as it resizes. */
  .qt-host { position: absolute; inset: 0; }
  .editor-loading { position: absolute; inset: 0; z-index: 1; }
  /* Over the unlock scrim too: the editor underneath is gone. */
  .editor-stopped { z-index: 40; gap: 8px; }
  .editor-stopped[hidden] { display: none; }
  .editor-stopped button {
    border: 1px solid var(--blockstitch-text-dim);
    border-radius: 6px;
    background: none;
    color: inherit;
    font: inherit;
    padding: 4px 10px;
    cursor: pointer;
  }
  /* A scrim over the editor until it's clicked, so scrolling the page past it
     still works. `editor-active` is set by the script. */
  .editor-unlock {
    position: absolute;
    inset: 0;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    border: none;
    border-radius: 0;
    background: color-mix(in srgb, var(--blockstitch-bg) 55%, transparent);
    box-shadow: none;
    color: var(--blockstitch-text);
    font-size: 15px;
    font-weight: 600;
  }
  .editor-unlock:hover:not(:disabled) { background: color-mix(in srgb, var(--blockstitch-bg) 40%, transparent); transform: none; }
  .editor-unlock :global(svg) { width: 18px; height: 18px; }
  .unlock-tap { display: none; }
  .editor-done { display: none; }
  .editor-active .editor-unlock { display: none; }
  .editor-active .editor-done {
    display: block;
    margin-left: auto;
    padding: 2px 10px;
    min-height: 0;
    font-size: 12px;
  }
  @media (pointer: coarse) {
    .unlock-click { display: none; }
    .unlock-tap { display: inline; }

    /* Before the editor is activated, it's laid out at a fixed desktop-ish
       width and scaled down to fit the phone screen (by Qt, see the script
       below), so the sidebar and canvas keep their normal proportions instead
       of the fixed-minimum sidebar width dominating a narrow viewport. The
       frame keeps the desktop layout's 680:420 shape; `--editor-preview-
       scale` is computed from its real width, and the fallback keeps things
       reasonable before that first runs. */
    .editor-window:not(.editor-active) .editor-body {
      height: calc(420px * var(--editor-preview-scale, 0.5));
    }

    /* Activating the editor drops the scaled preview and gives it the whole
       screen instead of the small in-page frame, so there's room for the
       sidebar and canvas at their real (unscaled) size. It floats with a
       gap from the screen edges (rather than going truly edge-to-edge) so
       nothing sits flush against the phone's bezel/corners, with a dimmed
       scrim behind it covering the rest of the page.
       The site header is hidden outright below rather than out-z-indexed. */
    .editor-window.editor-active {
      position: fixed;
      inset: 14px;
      z-index: 10;
    }
    .editor-window.editor-active .editor-body {
      height: calc(100% - 30px);
    }
    .editor-window.editor-active ~ .editor-mobile-scrim {
      display: block;
    }
  }
  :global(body.editor-fullscreen-lock .site-header) { display: none; }
  /* Sidebar and canvas both get more room in landscape; nudge phone users to
     rotate once they're actually in the editor. Dismissible per-open (see the
     script below, which clears the dismissal on each activate). */
  @media (pointer: coarse) and (orientation: portrait) {
    .editor-active .editor-rotate-hint:not(.dismissed) {
      display: flex;
    }
  }
  .editor-mobile-scrim {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 5;
    background: rgba(0, 0, 0, 0.6);
  }
  .editor-rotate-hint {
    display: none;
    position: absolute;
    top: 10px;
    left: 10px;
    right: 10px;
    z-index: 60;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    border-radius: 8px;
    background: color-mix(in srgb, var(--blockstitch-bg2) 94%, transparent);
    border: 1px solid var(--blockstitch-border);
    box-shadow: var(--blockstitch-shadow-lg);
    font-size: 12px;
    font-weight: 600;
    color: var(--blockstitch-text);
  }
  .editor-rotate-hint :global(svg) { width: 16px; height: 16px; flex-shrink: 0; }
  .editor-rotate-hint span { flex: 1; }
  .editor-rotate-dismiss {
    border: none;
    background: none;
    padding: 2px 4px;
    min-height: 0;
    font-size: 14px;
    line-height: 1;
    color: var(--blockstitch-text-dim);
  }
  .editor-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: var(--blockstitch-text-dim);
    font-size: 13px;
  }
  /* The editor becomes a fixed fullscreen overlay on phones once active (see
     above); keep the page underneath from scrolling while it's up. */
  :global(body.editor-fullscreen-lock) { overflow: hidden; }

  .editor-caption {
    margin-top: 10px;
    font-size: 12px;
    color: var(--blockstitch-text-dim);
    text-align: center;
  }

  /* One row per feature: the copy on one side and the live blocks (drawn by
     Qt, see qt-demo/PreviewStage.qml) straight on the page background on the other,
     swapping sides every row. */
  .features {
    display: flex;
    flex-direction: column;
    gap: clamp(48px, 7vw, 96px);
    margin-top: clamp(48px, 6vw, 80px);
  }
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: center;
    gap: clamp(24px, 4vw, 56px);
  }
  .feature:nth-child(even) .feature-copy { order: 2; }
  .feature-copy h3 {
    margin: 0;
    font-size: clamp(22px, 2.4vw, 28px);
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--blockstitch-text);
    text-wrap: balance;
  }
  .feature-copy p {
    margin-top: 12px;
    max-width: 44ch;
    font-size: 16px;
    line-height: 1.65;
    color: var(--blockstitch-text-dim);
  }
  .feature-stage {
    position: relative;
    height: 400px;
  }
  /* Illustrations only: Qt draws real blocks here, but the page keeps every
     pointer event, so scrolling over one scrolls the page. */
  .feature-stage .qt-host { pointer-events: none; }

  .specs { max-width: 560px; margin: 48px auto 0; }
  .specs .panel-row { padding: 12px 18px; gap: 16px; align-items: baseline; }
  .specs dt { width: 120px; flex-shrink: 0; font-size: 13px; color: var(--blockstitch-text-dim); }
  .specs dd { margin: 0; font-size: 14px; color: var(--blockstitch-text); }
  .specs a { color: var(--blockstitch-accent); text-decoration: none; }
  .specs a:hover { text-decoration: underline; }
  @media (max-width: 520px) {
    .specs .panel-row { flex-direction: column; gap: 2px; }
  }

  .section-alt {
    /* A light tint rather than the full glass fill, so the page background still shows through. */
    background: color-mix(in srgb, var(--blockstitch-bg2) 30%, transparent);
    border-top: 1px solid var(--blockstitch-glass-border);
    border-bottom: 1px solid var(--blockstitch-glass-border);
  }

  .cta {
    display: flex;
    align-items: center;
    gap: 32px;
    padding: 40px;
  }
  .cta-logo { flex-shrink: 0; filter: drop-shadow(var(--blockstitch-shadow-md)); }
  .cta-actions { margin-top: 20px; }

  @media (max-width: 520px) {
    .hero-brand { font-size: 64px; }
    .hero-lockup { flex-direction: column; gap: 16px; }
    .hero-brand img { width: 96px; height: 96px; }
  }
  @media (max-width: 760px) {
    .feature { grid-template-columns: 1fr; gap: 8px; }
    .feature:nth-child(even) .feature-copy { order: 0; }
    .feature-stage { height: 340px; }
  }
  @media (max-width: 640px) {
    .cta { flex-direction: column; align-items: flex-start; padding: 28px; }
  }
</style>
