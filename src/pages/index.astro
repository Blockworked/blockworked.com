---
import Base from '../layouts/Base.astro';
import DemoEditor from '../demo/DemoEditor.vue';
import Downloader from '../components/Downloader.astro';
import Screenshots from '../components/Screenshots.astro';
import GitHubMark from '../components/GitHubMark.astro';
import {
  BatteryCharging, Blocks, ChevronDown, Circle, Clock, Equal, GitBranch, Keyboard, Layers,
  Monitor, MousePointerClick, Move, Play, ShieldCheck, Square,
} from '@lucide/astro';
import { REPO_URL } from '../lib/releases';
---

<Base>
  <section class="hero">
    <div class="container">
      <div class="hero-copy">
        <h1>Macros you can <span class="accent">see</span>.</h1>
        <p class="hero-lede">
          Blockwork lets you build keyboard and mouse macros by snapping blocks together — no code, no
          guesswork. Record what you do, tweak it block by block, and fire it off with a hotkey. Free and
          open source, for Windows, macOS, and Linux.
        </p>
        <div class="hero-actions">
          <Downloader mode="compact" align="center">
            <a slot="actions" class="btn btn-lg" href={REPO_URL}><GitHubMark width="16" height="16" />View source</a>
          </Downloader>
        </div>
      </div>
      <div class="hero-editor">
        <div class="editor-window">
          <div class="editor-titlebar" aria-hidden="true">
            <span class="dot"></span><span class="dot"></span><span class="dot"></span>
            <span class="editor-titlebar-name">Blockwork</span>
          </div>
          <div class="editor-body">
            <DemoEditor client:only="vue">
              <div slot="fallback" class="editor-loading dot-grid">Loading the editor…</div>
            </DemoEditor>
          </div>
        </div>
        <p class="editor-caption">A live copy of Blockwork's editor — edits stay in this tab and nothing runs.</p>
      </div>
    </div>
  </section>

  <section class="section" id="features">
    <div class="container">
      <h2 class="section-heading">Everything a macro needs, nothing to memorize.</h2>
      <p class="section-lede">
        Every instruction is a block with its own inputs. Value and condition slots are shaped by type,
        so you can tell what goes where at a glance.
      </p>

      <div class="features">
        <article class="panel feature">
          <h3 class="panel-title"><Circle />Record</h3>
          <div class="feature-stage dot-grid" aria-hidden="true">
            <button type="button" class="btn-active-record" tabindex="-1"><span class="btn-icon-glyph"><Square /></span><span>Stop recording</span></button>
          </div>
          <p>
            Hit record and use your computer normally. Keystrokes, clicks, and even mouse movement come
            back as editable blocks.
          </p>
        </article>

        <article class="panel feature">
          <h3 class="panel-title"><Blocks />Snap together</h3>
          <div class="feature-stage dot-grid" aria-hidden="true">
            <div class="strand-body">
              <div class="instruction-row">
                <div class="instruction-shape">
                  <Keyboard class="instruction-type-icon" />
                  <div class="instruction-content">
                    <span class="instruction-label">Key:</span>
                    <button type="button" class="btn-chip" tabindex="-1">Enter</button>
                  </div>
                </div>
              </div>
              <div class="instruction-row">
                <div class="instruction-shape">
                  <MousePointerClick class="instruction-type-icon" />
                  <div class="instruction-content">
                    <span class="instruction-label">Mouse:</span>
                    <button type="button" class="dd-trigger dd-compact" tabindex="-1">Left<ChevronDown /></button>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <p>
            Keys, text, clicks, scrolling, mouse moves, shell commands, and opening or quitting apps —
            drag them into a stack and reorder at will.
          </p>
        </article>

        <article class="panel feature">
          <h3 class="panel-title"><GitBranch />Loops &amp; logic</h3>
          <div class="feature-stage dot-grid" aria-hidden="true">
            <div class="strand-body">
              <div class="instruction-row instruction-row-wrap">
                <div class="wrap-head-line">
                  <GitBranch class="instruction-type-icon-inline" />
                  <span class="instruction-label">if</span>
                  <span class="value-block value-card-shape-bool">
                    <span class="value-block value-card-shape"><span class="value-op">clicks</span></span>
                    <span class="value-op">&lt;</span>
                    <span class="value-block"><input type="text" value="100" size="3" readonly tabindex="-1" /></span>
                  </span>
                  <span class="instruction-label">then</span>
                </div>
                <div class="wrap-mouth">
                  <div class="strand-body">
                    <div class="instruction-row">
                      <div class="instruction-shape">
                        <Move class="instruction-type-icon" />
                        <div class="instruction-content"><span class="instruction-label">Move mouse:</span></div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="wrap-foot-bar"></div>
              </div>
            </div>
          </div>
          <p>
            Repeat, forever, while, and If / If-Else blocks, with boolean conditions that only fit where a
            condition belongs.
          </p>
        </article>

        <article class="panel feature">
          <h3 class="panel-title"><Equal />Variables</h3>
          <div class="feature-stage dot-grid" aria-hidden="true">
            <div class="instruction-row solo">
              <div class="instruction-shape">
                <Equal class="instruction-type-icon" />
                <div class="instruction-content">
                  <span class="instruction-label">set</span>
                  <button type="button" class="dd-trigger dd-compact" tabindex="-1">delay<ChevronDown /></button>
                  <span class="instruction-label">to</span>
                  <span class="value-block value-card-shape">
                    <span class="value-op">pick random from</span>
                    <span class="value-block"><input type="text" value="80" size="2" readonly tabindex="-1" /></span>
                    <span class="value-op">to</span>
                    <span class="value-block"><input type="text" value="120" size="3" readonly tabindex="-1" /></span>
                  </span>
                </div>
              </div>
            </div>
          </div>
          <p>
            Store numbers and text, combine them with operators like Join and Random, and watch their
            values preview live right in the editor.
          </p>
        </article>

        <article class="panel feature">
          <h3 class="panel-title"><Layers />Custom blocks</h3>
          <div class="feature-stage dot-grid" aria-hidden="true">
            <div class="instruction-row solo blockwork-custom-block" style="--blockwork-custom-block-color: #bf5af2">
              <div class="instruction-shape">
                <Blocks class="instruction-type-icon" />
                <div class="instruction-content">
                  <span class="instruction-label">log in as</span>
                  <span class="value-block"><input type="text" value="player1" size="7" readonly tabindex="-1" /></span>
                </div>
              </div>
            </div>
          </div>
          <p>
            Wrap a sequence you use often into your own block, give it inputs and a color, and reuse it
            anywhere in the macro.
          </p>
        </article>

        <article class="panel feature">
          <h3 class="panel-title"><Play />Hotkeys &amp; triggers</h3>
          <div class="feature-stage dot-grid" aria-hidden="true">
            <div class="instruction-row solo instruction-row-when-ran instruction-row-header">
              <div class="instruction-shape">
                <div class="instruction-content">
                  <BatteryCharging />
                  <span class="instruction-label when-ran-label">When battery charged to</span>
                  <span class="value-block"><input type="text" value="80" size="2" readonly tabindex="-1" /></span>
                  <span class="instruction-label">%</span>
                </div>
              </div>
            </div>
          </div>
          <p>
            Start and stop any macro with a global hotkey, or trigger it on a schedule, when power is
            plugged in, or when the battery hits a level.
          </p>
        </article>
      </div>

      <div class="platforms panel">
        <div class="panel-row">
          <Monitor class="row-icon" />
          <span class="panel-row-label"><strong>Native on Windows, macOS, and Linux</strong> — including Wayland, with Flatpak and AppImage builds.</span>
        </div>
        <div class="panel-row">
          <ShieldCheck class="row-icon" />
          <span class="panel-row-label"><strong>Runs entirely on your machine</strong> — no account, no cloud. GPL-3.0 licensed.</span>
        </div>
        <div class="panel-row">
          <Clock class="row-icon" />
          <span class="panel-row-label"><strong>Precise, human-like timing</strong> — fractional waits with optional random variance.</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt" id="screenshots">
    <div class="container">
      <h2 class="section-heading">A canvas for your automations.</h2>
      <p class="section-lede">Pan, zoom, leave comments, and keep as many macros as you like — with light and dark themes.</p>
      <Screenshots />
    </div>
  </section>

  <section class="section" id="download">
    <div class="container">
      <div class="cta panel dot-grid">
        <img src="/logo.png" alt="" width="88" height="88" class="cta-logo" />
        <div class="cta-copy">
          <h2 class="section-heading">Get Blockwork</h2>
          <p class="section-lede">Free and open source. Grab the latest release for your platform.</p>
          <div class="cta-actions"><Downloader mode="compact" /></div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    padding: 72px 0 40px;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: -20% -10% auto;
    height: 720px;
    background: radial-gradient(ellipse 50% 60% at 50% 30%, rgba(var(--blockstitch-accent-rgb), 0.18), transparent 70%);
    pointer-events: none;
  }
  .hero .container { position: relative; }
  .hero-copy {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }
  h1 {
    font-size: clamp(40px, 6.4vw, 68px);
    line-height: 1.02;
    font-weight: 800;
    letter-spacing: -0.035em;
  }
  .accent {
    background: linear-gradient(160deg, var(--blockstitch-accent-light), var(--blockstitch-accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-lede {
    margin: 18px auto 0;
    max-width: 58ch;
    font-size: 18px;
    color: var(--blockstitch-text-dim);
    text-wrap: pretty;
  }
  .hero-actions { margin-top: 28px; }
  .hero-editor { margin-top: 56px; }
  .editor-window {
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--blockstitch-border);
    background: var(--blockstitch-bg);
    box-shadow: var(--blockstitch-shadow-lg), 0 0 0 1px var(--blockstitch-glass-border);
  }
  .editor-titlebar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 6px;
    height: 30px;
    padding: 0 12px;
    background: var(--blockstitch-bg2);
    border-bottom: 1px solid var(--blockstitch-glass-border);
  }
  .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--blockstitch-bg3); border: 1px solid var(--blockstitch-border); }
  .editor-titlebar-name {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    font-size: 12px;
    color: var(--blockstitch-text-dim);
  }
  /* blockstitch's editor expects to fill a fixed-size window. */
  .editor-body {
    position: relative;
    height: min(600px, 78vh);
    font-size: 14px;
    line-height: normal;
  }
  .editor-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: var(--blockstitch-text-dim);
    font-size: 13px;
  }
  .editor-caption {
    margin-top: 10px;
    font-size: 12px;
    color: var(--blockstitch-text-dim);
    text-align: center;
  }

  .features {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--blockstitch-spacing);
    margin-top: 40px;
  }
  .feature { display: flex; flex-direction: column; container-type: inline-size; }
  .feature h3 { margin: 0; }
  .feature-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 176px;
    padding: 12px;
    border-bottom: 1px solid var(--blockstitch-glass-border);
    overflow: hidden;
    font-size: 14px;
    line-height: normal;
  }
  /* Illustrations only — look like real blocks (hover included), but nothing grabs or types. */
  .feature-stage :global(*) { cursor: default; }
  .feature-stage :global(input), .feature-stage :global(button) { pointer-events: none; }
  .feature-stage :global(.instruction-row.solo) { margin-bottom: 0; }
  /* Scale the wider illustrations down rather than clip them in narrow cards. */
  @container (max-width: 480px) { .feature-stage > :global(*) { zoom: 0.8; } }
  /* Blockwork's custom-block coloring (ui/src/custom-block-color.css) isn't part of blockstitch. */
  .feature-stage :global(.blockwork-custom-block .instruction-type-icon) { color: var(--blockwork-custom-block-color); }
  :global(body:not(.bs-dragging)) .feature-stage :global(.instruction-row.blockwork-custom-block:hover::before) { background: var(--blockwork-custom-block-color); }
  .feature p {
    padding: 14px 16px 16px;
    font-size: 14px;
    color: var(--blockstitch-text-dim);
  }

  .platforms { margin-top: var(--blockstitch-spacing); }
  .platforms .panel-row { padding: 12px 16px; gap: 12px; }
  .platforms .panel-row-label { font-size: 14px; color: var(--blockstitch-text-dim); }
  .platforms strong { color: var(--blockstitch-text); font-weight: 600; }
  .row-icon { width: 18px; height: 18px; color: var(--blockstitch-accent); flex-shrink: 0; }

  .section-alt {
    background: var(--blockstitch-glass-bg);
    border-top: 1px solid var(--blockstitch-glass-border);
    border-bottom: 1px solid var(--blockstitch-glass-border);
  }

  .cta {
    display: flex;
    align-items: center;
    gap: 32px;
    padding: 40px;
  }
  .cta-logo { flex-shrink: 0; filter: drop-shadow(var(--blockstitch-shadow-md)); }
  .cta-actions { margin-top: 20px; }

  @media (max-width: 960px) {
    .features { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .hero { padding-top: 48px; }
    .features { grid-template-columns: 1fr; }
    .cta { flex-direction: column; align-items: flex-start; padding: 28px; }
  }
</style>
