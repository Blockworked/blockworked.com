---
import Base from '../layouts/Base.astro';
import DemoEditor from '../demo/DemoEditor.vue';
import BlockPreview from '../demo/BlockPreview.vue';
import SnapPreview from '../demo/SnapPreview.vue';
import Downloader from '../components/Downloader.astro';
import Screenshots from '../components/Screenshots.astro';
import GitHubMark from '../components/GitHubMark.astro';
import {
  Blocks, ChevronDown, Circle, Hand, Equal, GitBranch, Layers, Play, Plus, Settings, SlidersHorizontal,
  Square, Trash2,
} from '@lucide/astro';
import { REPO_URL } from '../lib/releases';
---

<Base>
  <section class="hero">
    <div class="container hero-copy">
      <h1 class="hero-brand">
        <span class="hero-lockup">
          <img src="/logo.png" alt="" width="512" height="512" />
          <span>Blockwork</span>
        </span>
      </h1>
      <p class="hero-tagline">Powerful, understandable & fun <span class="accent">automation</span></p>
      <div class="hero-actions">
        <Downloader mode="compact" align="center">
          <a slot="actions" class="btn btn-lg" href={REPO_URL}><GitHubMark width="16" height="16" />View source</a>
        </Downloader>
      </div>
    </div>
    <a class="scroll-cue" href="#try" aria-label="Scroll down"><ChevronDown /></a>
  </section>

  <section class="try" id="try">
    <div class="container">
      <div class="hero-editor">
        <div class="editor-window" data-editor-window>
          <div class="editor-titlebar">
            <span class="dot" aria-hidden="true"></span><span class="dot" aria-hidden="true"></span><span class="dot" aria-hidden="true"></span>
            <span class="editor-titlebar-name" aria-hidden="true">Blockwork</span>
            <button type="button" class="editor-done" data-editor-done>Done</button>
          </div>
          <div class="editor-body">
            <DemoEditor client:only="vue">
              <div slot="fallback" class="editor-loading dot-grid">Loading the editor…</div>
            </DemoEditor>
            <!-- On touch screens the editor would swallow every swipe that lands
                 on it, so it stays locked until tapped (see the script below). -->
            <button type="button" class="editor-unlock" data-editor-unlock>
              <Hand />Tap to try the editor
            </button>
          </div>
        </div>
        <p class="editor-caption">A live copy of Blockwork's editor. Edits stay in this tab and nothing runs.</p>
      </div>
    </div>
  </section>

  <section class="section" id="features">
    <div class="container">
      <h2 class="section-heading">Everything a macro needs, nothing to memorize</h2>
      <p class="section-lede">
        Every instruction is a block with its own inputs. Value and condition slots are shaped by type,
        so you can tell what goes where at a glance.
      </p>

      <div class="features">
        <article class="panel feature">
          <h3 class="panel-title"><Circle />Record</h3>
          <div class="feature-stage record-stage" aria-hidden="true" inert>
            <!-- The top-right corner of Blockwork's main window mid-recording:
                 the macro selector row (its left side left out), then the run row with Record on the right. -->
            <div class="mini-window">
              <div class="editor-titlebar"></div>
              <div class="toolbar-row">
                <div class="selector-left"></div>
                <div class="selector-right">
                  <button type="button"><span class="btn-icon-glyph"><Plus /></span><span>New macro</span></button>
                  <button type="button" class="btn-danger"><span class="btn-icon-glyph"><Trash2 /></span><span>Delete</span></button>
                  <button type="button"><span class="btn-icon-glyph"><Settings /></span><span>Settings</span></button>
                </div>
              </div>
              <div class="toolbar-row">
                <div class="run-right">
                  <button type="button" class="btn-active-record"><span class="btn-icon-glyph"><Square /></span><span>Stop recording</span></button>
                  <button type="button"><span class="btn-icon-glyph"><SlidersHorizontal /></span></button>
                </div>
              </div>
            </div>
          </div>
          <p>
            Hit record and use your computer normally. Keystrokes, clicks, and even mouse movement come
            back as editable blocks.
          </p>
        </article>

        <article class="panel feature">
          <h3 class="panel-title"><Blocks />Snap together</h3>
          <div class="feature-stage dot-grid" aria-hidden="true">
            <SnapPreview client:only="vue" />
          </div>
          <p>
            Keys, text, clicks, scrolling, mouse moves, shell commands, and opening or quitting apps.
            Drag them into a stack and reorder at will.
          </p>
        </article>

        <article class="panel feature">
          <h3 class="panel-title"><GitBranch />Loops &amp; logic</h3>
          <div class="feature-stage dot-grid" aria-hidden="true">
            <BlockPreview client:only="vue" preset="if-click" />
          </div>
          <p>
            Repeat, forever, while, and If / If-Else blocks, with boolean conditions that only fit where a
            condition belongs.
          </p>
        </article>

        <article class="panel feature">
          <h3 class="panel-title"><Equal />Variables</h3>
          <div class="feature-stage dot-grid" aria-hidden="true">
            <BlockPreview client:only="vue" preset="set-random" />
          </div>
          <p>
            Store numbers and text, combine them with operators like Join and Random, and watch their
            values preview live right in the editor.
          </p>
        </article>

        <article class="panel feature">
          <h3 class="panel-title"><Layers />Custom blocks</h3>
          <div class="feature-stage dot-grid" aria-hidden="true">
            <BlockPreview client:only="vue" preset="custom-block" />
          </div>
          <p>
            Wrap a sequence you use often into your own block, give it inputs and a color, and reuse it
            anywhere in the macro.
          </p>
        </article>

        <article class="panel feature">
          <h3 class="panel-title"><Play />Hotkeys &amp; triggers</h3>
          <div class="feature-stage dot-grid" aria-hidden="true">
            <BlockPreview client:only="vue" preset="battery" />
          </div>
          <p>
            Start and stop any macro with a global hotkey, or trigger it on a schedule, when power is
            plugged in, or when the battery hits a level.
          </p>
        </article>
      </div>

      <dl class="specs panel">
        <div class="panel-row"><dt>Cross-platform</dt><dd>Windows, macOS, and Linux</dd></div>
        <div class="panel-row"><dt>Privacy</dt><dd>No account. Macros stay local.</dd></div>
        <div class="panel-row"><dt>Source Code</dt><dd><a href={REPO_URL}>GPL-3.0 on GitHub</a></dd></div>
      </dl>
    </div>
  </section>

  <section class="section section-alt" id="screenshots">
    <div class="container">
      <h2 class="section-heading">A canvas for your automations</h2>
      <p class="section-lede">Pan, zoom, leave comments, and keep as many macros as you like, with light and dark themes.</p>
      <Screenshots />
    </div>
  </section>

  <section class="section" id="download">
    <div class="container">
      <div class="cta panel">
        <img src="/logo.png" alt="" width="88" height="88" class="cta-logo" />
        <div class="cta-copy">
          <h2 class="section-heading">Get Blockwork</h2>
          <p class="section-lede">Free and open source. Grab the latest release for your platform.</p>
          <div class="cta-actions"><Downloader mode="compact" /></div>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // Touch screens: unlock the demo editor on tap, lock it again with Done.
  const editorWindow = document.querySelector<HTMLElement>('[data-editor-window]');
  document.querySelector('[data-editor-unlock]')?.addEventListener('click', () => editorWindow?.classList.add('editor-active'));
  document.querySelector('[data-editor-done]')?.addEventListener('click', () => editorWindow?.classList.remove('editor-active'));

  // The header's logo is hidden on the home page while the big title is on
  // screen, and appears once the title has scrolled out of view behind the
  // header (plus a little extra scroll); scrolling back up hides it again.
  /** Extra scroll past the point where the title is fully hidden, in px. */
  const SHOW_AFTER = 40;

  const title = document.querySelector<HTMLElement>('.hero-brand');
  const header = document.querySelector<HTMLElement>('.site-header');
  const brand = document.querySelector<HTMLElement>('.site-header .brand-home');

  if (title && header && brand) {
    let threshold = 0;

    const update = () => {
      const shown = window.scrollY > threshold;
      brand.classList.toggle('brand-shown', shown);
      brand.toggleAttribute('inert', !shown);
    };

    const measure = () => {
      const titleBottom = title.getBoundingClientRect().bottom + window.scrollY;
      threshold = titleBottom - header.getBoundingClientRect().bottom + SHOW_AFTER;
      update();
    };

    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', measure);
    document.fonts?.ready.then(measure);
    window.addEventListener('load', measure);
    measure();
  }
</script>

<style>
  /* The header is 56px tall (SiteHeader.astro); the hero fills the rest of the first screen. */
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: calc(100vh - 56px);
    min-height: calc(100svh - 56px);
    padding: 80px 0 112px;
  }
  .hero-copy {
    position: relative;
    max-width: 1000px;
    text-align: center;
  }
  /* The logo and name are the headline: the lockup leads, the tagline follows. */
  .hero-brand {
    font-size: clamp(56px, 11vw, 148px);
    line-height: 1;
    font-weight: 800;
    letter-spacing: -0.045em;
  }
  .hero-lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.22em;
  }
  .hero-brand img {
    width: 1.05em;
    height: 1.05em;
    flex-shrink: 0;
  }
  .hero-tagline {
    margin-top: clamp(20px, 2.4vw, 32px);
    font-size: clamp(24px, 3vw, 38px);
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--blockstitch-text);
  }
  .accent { color: var(--blockstitch-accent); }
  /* Spacing grows between groups: logo + tagline, then the description, then the actions. */
  .hero-lede {
    margin: clamp(36px, 4.5vw, 56px) auto 0;
    max-width: 58ch;
    font-size: clamp(17px, 1.7vw, 20px);
    line-height: 1.7;
    color: color-mix(in srgb, var(--blockstitch-text) 78%, var(--blockstitch-text-dim));
    text-wrap: balance;
  }
  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 28px;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-left: -20px;
    border-radius: 50%;
    color: var(--blockstitch-text-dim);
    transition: color var(--blockstitch-dur-fast) var(--blockstitch-ease-standard), background var(--blockstitch-dur-fast) var(--blockstitch-ease-standard);
  }
  .scroll-cue:hover { color: var(--blockstitch-text); background: var(--blockstitch-hover-overlay); }
  .scroll-cue :global(svg) { width: 22px; height: 22px; }
  @media (prefers-reduced-motion: no-preference) {
    .scroll-cue :global(svg) { animation: cue-bob 2.4s var(--blockstitch-ease-standard) infinite; }
  }
  @keyframes cue-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(4px); }
  }

  .hero-actions { margin-top: clamp(36px, 4.5vw, 56px); display: flex; justify-content: center; }
  .hero-actions :global(.dl-primary) { gap: 18px; }
  .hero-actions :global(.btn-lg) { min-height: 48px; padding: 0 22px; }
  .try { padding: 24px 0 40px; }
  .editor-window {
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--blockstitch-border);
    background: var(--blockstitch-bg);
    box-shadow: var(--blockstitch-shadow-lg), 0 0 0 1px var(--blockstitch-glass-border);
  }
  .editor-titlebar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 6px;
    height: 30px;
    padding: 0 12px;
    background: var(--blockstitch-bg2);
    border-bottom: 1px solid var(--blockstitch-glass-border);
  }
  .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--blockstitch-bg3); border: 1px solid var(--blockstitch-border); }
  .editor-titlebar-name {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    font-size: 12px;
    color: var(--blockstitch-text-dim);
  }
  /* blockstitch's editor expects to fill a fixed-size window. */
  .editor-body {
    position: relative;
    height: min(600px, 78vh);
    font-size: 14px;
    line-height: normal;
  }
  /* Touch screens: a scrim over the editor until it's tapped, so scrolling the
     page past it still works. `editor-active` is set by the script. */
  .editor-unlock,
  .editor-done { display: none; }
  @media (pointer: coarse) {
    .editor-body { height: min(520px, 65svh); }
    .editor-unlock {
      position: absolute;
      inset: 0;
      z-index: 30;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      border: none;
      border-radius: 0;
      background: color-mix(in srgb, var(--blockstitch-bg) 55%, transparent);
      box-shadow: none;
      color: var(--blockstitch-text);
      font-size: 15px;
      font-weight: 600;
    }
    .editor-unlock :global(svg) { width: 18px; height: 18px; }
    .editor-active .editor-unlock { display: none; }
    .editor-active .editor-done {
      display: block;
      margin-left: auto;
      padding: 2px 10px;
      min-height: 0;
      font-size: 12px;
    }
  }
  .editor-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: var(--blockstitch-text-dim);
    font-size: 13px;
  }
  .editor-caption {
    margin-top: 10px;
    font-size: 12px;
    color: var(--blockstitch-text-dim);
    text-align: center;
  }

  .features {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--blockstitch-spacing);
    margin-top: 40px;
  }
  .feature { display: flex; flex-direction: column; container-type: inline-size; }
  .feature h3 { margin: 0; }
  .feature-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 176px;
    padding: 8px;
    border-bottom: 1px solid var(--blockstitch-glass-border);
    overflow: hidden;
    font-size: 14px;
    line-height: normal;
  }
  /* Illustrations only — look like real blocks (hover included), but nothing grabs or types. */
  .feature-stage :global(*) { cursor: default; }
  /* Scale the wider illustrations down rather than clip them in narrow cards. */
  .feature-stage :global(.block-preview) { zoom: 0.9; }
  @container (max-width: 420px) { .feature-stage :global(.block-preview) { zoom: 0.72; } }
  /* A cropped app window pinned to the stage's top-right corner; its left and
     bottom edges run off the card. */
  .record-stage { position: relative; padding: 0; justify-content: flex-start; align-items: stretch; }
  .mini-window {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 640px;
    height: 400px;
    border: 1px solid var(--blockstitch-border);
    border-radius: 12px;
    overflow: hidden;
    background: var(--blockstitch-bg);
    box-shadow: var(--blockstitch-shadow-md);
    font-size: 14px;
    zoom: 1.1;
  }
  .mini-window .run-right { gap: 6px; }
  .mini-window :global(svg) { width: 14px; height: 14px; }
  @container (max-width: 420px) { .mini-window { zoom: 0.92; } }
  .feature p {
    padding: 14px 16px 16px;
    font-size: 14px;
    color: var(--blockstitch-text-dim);
  }

  .specs { max-width: 560px; margin: 48px auto 0; }
  .specs .panel-row { padding: 12px 18px; gap: 16px; align-items: baseline; }
  .specs dt { width: 120px; flex-shrink: 0; font-size: 13px; color: var(--blockstitch-text-dim); }
  .specs dd { margin: 0; font-size: 14px; color: var(--blockstitch-text); }
  .specs a { color: var(--blockstitch-accent); text-decoration: none; }
  .specs a:hover { text-decoration: underline; }
  @media (max-width: 520px) {
    .specs .panel-row { flex-direction: column; gap: 2px; }
  }

  .section-alt {
    /* A light tint rather than the full glass fill, so the page background still shows through. */
    background: color-mix(in srgb, var(--blockstitch-bg2) 30%, transparent);
    border-top: 1px solid var(--blockstitch-glass-border);
    border-bottom: 1px solid var(--blockstitch-glass-border);
  }

  .cta {
    display: flex;
    align-items: center;
    gap: 32px;
    padding: 40px;
  }
  .cta-logo { flex-shrink: 0; filter: drop-shadow(var(--blockstitch-shadow-md)); }
  .cta-actions { margin-top: 20px; }

  @media (max-width: 960px) {
    .features { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 520px) {
    .hero-brand { font-size: 64px; }
    .hero-lockup { flex-direction: column; gap: 16px; }
    .hero-brand img { width: 96px; height: 96px; }
  }
  @media (max-width: 640px) {
    .features { grid-template-columns: 1fr; }
    .cta { flex-direction: column; align-items: flex-start; padding: 28px; }
  }
</style>
