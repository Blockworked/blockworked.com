---
import Base from '../../layouts/Base.astro';
import Downloader from '../../components/Downloader.astro';
import { REPO_URL } from '../../lib/releases';
import { languagePaths, locale } from '../../lib/i18n';

export const getStaticPaths = languagePaths;
const { t, th } = locale(Astro.url);
const link = (url: string, text: string) => `<a href="${url}">${text}</a>`;
---

<Base title={t('Download')} description={t('Download Blockwork for Windows, macOS, or Linux.')}>
  <section class="section download">
    <div class="container narrow">
      <img src="/logo.png" alt="" width="72" height="72" class="logo" />
      <h1 class="section-heading">{t('Get Blockwork')}</h1>
      <p class="section-lede" set:html={th('Free and open source under the GPL-3.0. Every build below comes straight from the latest {release}.', { release: link(`${REPO_URL}/releases/latest`, th('GitHub release')) })} />
      <div class="dl-wrap">
        <Downloader mode="full" />
      </div>
      <p class="build-note" set:html={th('Prefer to build it yourself? Clone the {repository} and run {command}.', { repository: link(REPO_URL, th('repository')), command: '<code>just</code>' })} />
    </div>
  </section>
</Base>

<style>
  .narrow { max-width: 760px; }
  .logo { margin-bottom: 20px; filter: drop-shadow(var(--blockstitch-shadow-md)); }
  .section-lede a, .build-note a { color: var(--blockstitch-accent); text-decoration: none; }
  .section-lede a:hover, .build-note a:hover { text-decoration: underline; }
  .dl-wrap { margin-top: 28px; }
  .build-note {
    margin-top: 32px;
    font-size: 13px;
    color: var(--blockstitch-text-dim);
  }
</style>
