---
// Rendered at build time from Blockwork's CHANGELOG.md (Keep a Changelog
// format) on its master branch, richer than the GitHub release bodies,
// which are generated from it at tag time and are sometimes just a stub.
import Base from '../../layouts/Base.astro';
import { Check, Tag } from '@lucide/astro';
import { RELEASES_URL, REPO_URL, changelog, formatDate } from '../../lib/releases';
import { languagePaths, locale } from '../../lib/i18n';

export const getStaticPaths = languagePaths;
const { t, th, tag } = locale(Astro.url);
// The notes themselves stay in English: they come from Blockwork's CHANGELOG.md.
const entries = await changelog();
---

<Base title={t('Changelog')} description={t("What's new in each Blockwork release.")}>
  <section class="section">
    <div class="container narrow">
      <h1 class="section-heading">{t("What's new")}</h1>
      <p class="section-lede">{t('Every Blockwork release, newest first.')}</p>

      {entries.length === 0 ? (
        <p class="fallback" set:html={th("The changelog couldn't be loaded when this page was built. See {link}.", { link: `<a href="${RELEASES_URL}">${th('releases on GitHub')}</a>` })} />
      ) : (
        <ol class="releases">
          {entries.map((e, i) => {
            const unreleased = e.version.toLowerCase() === 'unreleased';
            return (
              <li class:list={['release', { current: i === 0 && !unreleased }]}>
                <div class="release-marker" aria-hidden="true"></div>
                <article class="panel">
                  <header class="panel-title release-header">
                    <Tag />
                    {unreleased ? <span class="version">{t('Unreleased')}</span> : <a class="version" href={`${REPO_URL}/releases/tag/${e.version}`}>{e.version}</a>}
                    {i === 0 && !unreleased && <span class="latest"><Check />{t('latest')}</span>}
                    {e.date && <time datetime={e.date}>{formatDate(`${e.date}T12:00:00`, tag)}</time>}
                  </header>
                  <div class="notes" set:html={e.html || `<p>${th('No notes for this release.')}</p>`} />
                </article>
              </li>
            );
          })}
        </ol>
      )}
    </div>
  </section>
</Base>

<style>
  .narrow { max-width: 760px; }
  .fallback { margin-top: 32px; color: var(--blockstitch-text-dim); }
  .fallback a { color: var(--blockstitch-accent); }

  .releases {
    list-style: none;
    margin-top: 40px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .release { position: relative; padding-left: 28px; }
  /* A timeline spine, echoing the C-block spine. */
  .release::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 0;
    bottom: -20px;
    width: 1.5px;
    background: var(--blockstitch-border);
  }
  .release:last-child::before { bottom: 0; }
  .release-marker {
    position: absolute;
    left: 0;
    top: 12px;
    width: 12px;
    height: 12px;
    border-radius: 3px;
    background: var(--blockstitch-bg2);
    border: 1.5px solid var(--blockstitch-border);
  }
  .release.current .release-marker {
    background: var(--blockstitch-accent);
    border-color: var(--blockstitch-accent);
    box-shadow: var(--blockstitch-glow-accent);
  }
  .release-header { gap: 8px; }
  /* A version sits in the same box a block's value does. */
  .version {
    padding: 3px 7px;
    border-radius: 5px;
    border: 1px solid var(--blockstitch-border);
    background: var(--blockstitch-bg);
    color: var(--blockstitch-text);
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  a.version:hover { color: var(--blockstitch-accent); }
  .release-header time {
    margin-left: auto;
    text-transform: none;
    letter-spacing: 0;
    font-weight: 400;
    font-size: 12px;
  }
  /* The newest release: a tick and a word, not a pill. */
  .latest {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--blockstitch-text-dim);
    font-size: 13px;
    font-weight: 400;
  }
  .latest :global(svg) { width: 14px; height: 14px; color: #3ccf6e; }
  :root[data-theme="light"] .latest :global(svg) { color: #18743b; }

  .notes {
    padding: 12px 16px 16px;
    font-size: 14px;
  }
  .notes :global(h3) {
    margin: 14px 0 6px;
    font-size: 14px;
    color: var(--blockstitch-text);
  }
  .notes :global(h3:first-child) { margin-top: 0; }
  .notes :global(p) { margin: 6px 0; }
  .notes :global(ul) { padding-left: 20px; }
  .notes :global(li) { margin: 3px 0; }
  .notes :global(li::marker) { color: var(--blockstitch-text-dim); }
  .notes :global(a) { color: var(--blockstitch-accent); }
  .notes :global(code) {
    padding: 1px 5px;
    border-radius: 4px;
    background: var(--blockstitch-bg3);
  }
</style>
