# The Blockwork commit the page's editor is built from. blockstitch and
# lucide-qt are not pinned here: deps.sh reads them from that commit's
# Cargo.lock, so the page always gets the pair the app itself was tested with.
BLOCKWORK_REV=28218d074c4cfc1a5cb7eefa6f7f5b16cc1b65da

# The Qt for WebAssembly build and the Emscripten it was made with
# (QT_EMCC_RECOMMENDED_VERSION). The deploy workflow reads both from here.
QT_VERSION=6.12.0
EMSDK_VERSION=5.0.5
